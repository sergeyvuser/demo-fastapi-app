  "components": {
    "schemas": {
      "AccessToken": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          }
        },
        "type": "object",
        "required": [
          "access_token"
        ],
        "title": "AccessToken"
      },
      "AlertCondition": {
        "type": "string",
        "enum": [
          "price_above",
          "price_below"
        ],
        "title": "AlertCondition"
      },
      "AlertCreate": {
        "properties": {
          "symbol": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9]{5,20}$",
            "title": "Symbol"
          },
          "condition": {
            "$ref": "#/components/schemas/AlertCondition"
          },
          "threshold": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,21}0*$)\\d{0,12}\\.\\d{0,8}0*$)"
              }
            ],
            "title": "Threshold"
          },
          "repeat_policy": {
            "$ref": "#/components/schemas/AlertRepeatPolicy",
            "default": "while_true"
          },
          "cooldown_seconds": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 86400.0,
                "minimum": 60.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Cooldown Seconds",
            "default": 3600
          },
          "expires_in_seconds": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExpiryPreset"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "condition",
          "threshold"
        ],
        "title": "AlertCreate"
      },
      "AlertRead": {
        "properties": {
          "symbol": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9]{5,20}$",
            "title": "Symbol"
          },
          "condition": {
            "$ref": "#/components/schemas/AlertCondition"
          },
          "threshold": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,21}0*$)\\d{0,12}\\.\\d{0,8}0*$)",
            "title": "Threshold"
          },
          "repeat_policy": {
            "$ref": "#/components/schemas/AlertRepeatPolicy",
            "default": "while_true"
          },
          "cooldown_seconds": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 86400.0,
                "minimum": 60.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Cooldown Seconds",
            "default": 3600
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "status": {
            "$ref": "#/components/schemas/AlertStatus",
            "description": "The Status in force now. An Alert whose `expires_at` has passed reads `expired` from that instant, even before the system has recorded it."
          },
          "last_triggered_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Triggered At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "trigger_count": {
            "type": "integer",
            "title": "Trigger Count"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "condition",
          "threshold",
          "id",
          "status",
          "last_triggered_at",
