    {
      "id": 11,
      "type": "timeseries",
      "title": "CPU by mode",
      "description": "Everything except idle, averaged across cores and stacked, so the top of the stack is total utilisation. `iowait` climbing while `user` stays flat means the machine is waiting on disk rather than computing — a different problem with the same symptom.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
