# Copy to .env and fill in. Only values without a working default live here.
# The application's defaults are in backend/src/backend/core/config.py and
# shared/src/shared/config.py; restating them here would create a second copy
# that drifts silently — the SMTP block said 587/starttls long after 465/tls
# was decided.

# --- Logging ---
APP_CONFIG__LOG__LEVEL=INFO

# --- Database ---
# DBConfig has no defaults at all, and compose builds the postgres container
# from the first three of these.
APP_CONFIG__DB__NAME=app
APP_CONFIG__DB__USERNAME=app
APP_CONFIG__DB__PASSWORD=change-me
APP_CONFIG__DB__HOST=127.0.0.1
APP_CONFIG__DB__PORT=5432

# python -c "import secrets; print(secrets.token_hex(32))"
APP_CONFIG__AUTH__SECRET_KEY=generate-me

# --- RabbitMQ ---
APP_CONFIG__RABBITMQ__USERNAME=rabbit
APP_CONFIG__RABBITMQ__PASSWORD=change-me

# --- PGAdmin ---
APP_CONFIG__RABBITMQ__HOST=127.0.0.1
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me

# --- Grafana ---
# required: compose refuses to start without it
GRAFANA_PASSWORD=change-me

# --- Redis ---
APP_CONFIG__REDIS__HOST=127.0.0.1
APP_CONFIG__REDIS__PORT=6379
APP_CONFIG__REDIS__DB=0

# --- SMTP ---
# local: mailpit, no auth
APP_CONFIG__SMTP__HOST=127.0.0.1
APP_CONFIG__SMTP__PORT=1025
APP_CONFIG__SMTP__SECURITY=none
# production example (Resend):
# APP_CONFIG__SMTP__HOST=smtp.resend.com
# APP_CONFIG__SMTP__PORT=587
# APP_CONFIG__SMTP__SECURITY=starttls
# APP_CONFIG__SMTP__USERNAME=resend
# APP_CONFIG__SMTP__PASSWORD=re_...
# APP_CONFIG__SMTP__SENDER=alerts@your-domain.tld

# --- Rate limiting (optional, defaults shown) ---
APP_CONFIG__AUTH__LOGIN_RATE_LIMIT=5
APP_CONFIG__AUTH__LOGIN_RATE_WINDOW_SECONDS=60
APP_CONFIG__AUTH__REGISTER_RATE_LIMIT=3
APP_CONFIG__AUTH__REGISTER_RATE_WINDOW_SECONDS=300

# --- Telegram notifications (optional) ---
APP_CONFIG__TELEGRAM__BOT_TOKEN=change-me
APP_CONFIG__TELEGRAM__CHAT_ID=change-me

# --- Run configuration ---
APP_CONFIG__RUN__PUBLIC_URL=change-me

# --- Logging configuration ---
APP_CONFIG__LOG__LEVEL=INFO
APP_CONFIG__LOG__JSON_FORMAT=False

# --- Jaeger ---
APP_CONFIG__OTEL__ENDPOINT=http://127.0.0.1:4317

# --- Production only (leave empty in development) ---
# reverse proxy peers allowed to set X-Forwarded-*; empty = no proxy
# APP_CONFIG__RUN__TRUSTED_PROXIES=["10.0.0.2"]
# host header allowlist; MUST include 127.0.0.1 or the container healthcheck fails
# APP_CONFIG__RUN__ALLOWED_HOSTS=["alerts.example.com", "127.0.0.1"]
# browser origins for the UI (stage 13)
# APP_CONFIG__RUN__CORS_ORIGINS=["https://alerts.example.com"]
# APP_CONFIG__RUN__PUBLIC_URL=https://alerts.example.com
# APP_CONFIG__RUN__RELOAD=false