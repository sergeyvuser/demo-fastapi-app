# Copy to .env and fill in. Only values without a working default live here.
# The application's defaults are in backend/src/backend/core/config.py and
# shared/src/shared/config.py; restating them here would create a second copy
# that drifts silently — the SMTP block said 587/starttls long after 465/tls
# was decided.

# --- Database ---
# DBConfig has no defaults at all, and compose builds the postgres container
# from the first three of these.
APP_CONFIG__DB__NAME=app
APP_CONFIG__DB__USERNAME=app
APP_CONFIG__DB__PASSWORD=change-me
# compose overrides this with `db`
APP_CONFIG__DB__HOST=127.0.0.1
APP_CONFIG__DB__PORT=5432

# uncomment to enable sqla echo for development
# APP_CONFIG__DB__SQLA__ECHO=1

# python -c "import secrets; print(secrets.token_hex(32))"
APP_CONFIG__AUTH__SECRET_KEY=generate-me

# --- PGAdmin ---
# Read by compose substitution only, never by the application
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me

# --- RabbitMQ ---
# The password has no default. The username does have one ("rabbit"), but
# compose passes it to the broker container too, where an empty value means a
# different account than the one the application then tries to log in as.
APP_CONFIG__RABBITMQ__USERNAME=rabbit
APP_CONFIG__RABBITMQ__PASSWORD=change-me

# --- Grafana ---
# Read by compose substitution only, never by the application
# required: compose refuses to start without it
GRAFANA_PASSWORD=change-me

# --- Notifier ---
APP_CONFIG__TELEGRAM__BOT_TOKEN=change-me

# Production-only settings (trusted proxies, allowed hosts, public URL) are
# not listed here on purpose: they are decided in deploy/compose.prod.yaml,
# where the reasoning for each value sits next to it.
