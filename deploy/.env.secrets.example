# Every configuration value the stack needs, secret or not. Generated once on
# the server and never rewritten by a deploy, so a configuration change cannot
# destroy credentials. Values below are placeholders, not secrets.
#
# Read twice: through `--env-file` (for ${...} in the compose files) and
# through `env_file:` (into the application containers).

APP_CONFIG__DB__NAME=crypto_alerts_db
APP_CONFIG__DB__USERNAME=alerts
APP_CONFIG__DB__PASSWORD=replace-me
APP_CONFIG__DB__PORT=5432

APP_CONFIG__RABBITMQ__USERNAME=alerts
APP_CONFIG__RABBITMQ__PASSWORD=replace-me

APP_CONFIG__AUTH__SECRET_KEY=replace-me

# Resend API key: the username is the literal "resend" (set in the overlay)
APP_CONFIG__SMTP__PASSWORD=replace-me

APP_CONFIG__TELEGRAM__BOT_TOKEN=replace-me

GRAFANA_PASSWORD=replace-me
