# The single public door into the system. Every other service publishes no
# ports at all, so what is described here is the whole public surface.
#
# Mounted read-only at /etc/caddy/Caddyfile by deploy/compose.prod.yaml. The
# hostnames are literals — they are public DNS records anyway — while the two
# ACME settings arrive as container environment: a personal address stays out
# of a public repository, and the staging endpoint can be switched on for a
# rehearsal without editing a file that travels with the commit.
{
	email {$ACME_EMAIL}

	# Which ACME directory issues our certificates. The compose file defaults
	# this to Let's Encrypt production. The first issuance on a new host is
	# rehearsed against the staging directory, whose certificates browsers
	# reject but whose rate limits are effectively unlimited: production allows
	# 5 duplicate certificates per week and that is the one mistake here which
	# cannot be fixed by trying again.
	acme_ca {$ACME_CA}
}

# Shared by every site: what every response carries, what gets written down,
# and what never leaves the compose network.
(edge) {
	header {
		# One year. No includeSubDomains: the zone is personal and carries
		# names this proxy does not serve.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Skipped automatically for upgraded connections and already-compressed
	# bodies; what it actually buys is /docs and the JSON responses.
	encode zstd gzip

	# Access logging is off by default in Caddy. Without it there is no record
	# of who asked for what — including the ACME challenge requests during the
	# first issuance. The daemon's own log (certificate events, errors) is
	# separate and always on.
	log {
		format json
	}

    # Every site, not just the API: Prometheus scrapes api:8080/metrics inside
	# the compose network, and Grafana serves its own /metrics unauthenticated
	# by default — verified on grafana/grafana:13.1.1, a plain 200. From the
	# outside neither must even admit to existing, hence 404 rather than 403.
	# Handle blocks are sorted by path specificity, so this one wins over each
	# site's catch-all no matter that the import comes first.
	handle /metrics* {
		respond 404
	}
}

alerts.vorobev.dev {
	import edge

	# Two paths that must not be public. Both are fixed in the application as
	# well (ticket 08); they are blocked here too because the proxy needs no
	# rebuild, and because an upgrade of FastStream could re-add its schema
	# route without anyone noticing.
	#   /asyncapi*      — FastStream's schema, which published the broker URL
	#                     with its password to anonymous callers
	#   /api/v1/users   — returned every registered address; the exact path
	#                     only, so /api/v1/users/me keeps working
	handle /asyncapi* {
		respond 404
	}

	handle /api/v1/users {
		respond 404
	}

	# The API's root-level paths, which exist for callers inside the compose
	# network — the container healthcheck, the scraper, the operator — and stay
	# exactly where they are in the application. Past the catch-all below they
	# would no longer reach the API anyway, but they would answer with the app
	# shell and a 200: an outside uptime check pointed at /healthz would report
	# a dead API as alive. A 404 says what is true. /metrics is in the snippet,
	# since Grafana needs it too.
	handle /healthz {
		respond 404
	}

	handle /readyz {
		respond 404
	}

	handle /internal/* {
		respond 404
	}

	# The whole API, documentation included (/api/docs, /api/openapi.json).
	# This is why the application may add no route outside /api (ADR 0004):
	# a root-level path would land in the catch-all and quietly serve the
	# shell. WebSocket upgrades under /api need no configuration — the proxy
	# recognises the upgrade and switches to a raw bidirectional stream. The
	# Host header passes through unchanged (unlike nginx's default), which is
	# what lets TrustedHostMiddleware see the real name.
	handle /api/* {
		reverse_proxy api:8080
	}

	# Everything else is the application. Which paths exist is the frontend
	# router's knowledge, not this file's: the frontend's own Caddy answers a
	# missing asset 404 and any other unknown path with the shell.
	handle {
		reverse_proxy frontend:8080
	}
}

grafana.vorobev.dev {
	import edge

	# `handle` rather than a bare directive: the snippet now brings a handle
	# block, and mixing the two styles in one site turns precedence into a
	# puzzle for whoever reads this next.
	handle {
		reverse_proxy grafana:3000
	}
}

# The bare domain and www have no content of their own yet; until a personal
# site exists they send people to the application. Temporary on purpose: a
# permanent redirect is cached by browsers indefinitely, and this one is
# meant to be replaced.
vorobev.dev, www.vorobev.dev {
	import edge

	# To the root, not {uri}: the apex has no paths of its own, and carrying
	# them across would forward scanners' /.env and /.git/config probes onto
	# the application's host for nothing.
	handle {
		redir https://alerts.vorobev.dev/ 302
	}
}
