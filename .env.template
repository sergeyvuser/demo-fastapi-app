# --- Database configuration ---
APP_CONFIG__DB__NAME=app
APP_CONFIG__DB__USERNAME=app
APP_CONFIG__DB__PASSWORD=change-me
APP_CONFIG__DB__HOST=127.0.0.1
APP_CONFIG__DB__PORT=5432

# python -c "import secrets; print(secrets.token_hex(32))"
APP_CONFIG__AUTH__SECRET_KEY=generate-me

# --- RabbitMQ ---
APP_CONFIG__RABBITMQ__USERNAME=rabbit
APP_CONFIG__RABBITMQ__PASSWORD=change-me

# --- PGAdmin ---
APP_CONFIG__RABBITMQ__HOST=127.0.0.1
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me

# --- Redis ---
APP_CONFIG__REDIS__HOST=127.0.0.1
APP_CONFIG__REDIS__PORT=6379
APP_CONFIG__REDIS__DB=0

# --- SMTP ---
APP_CONFIG__SMTP__HOST=127.0.0.1

# --- Rate limiting (optional, defaults shown) ---
APP_CONFIG__AUTH__LOGIN_RATE_LIMIT=5
APP_CONFIG__AUTH__LOGIN_RATE_WINDOW_SECONDS=60
APP_CONFIG__AUTH__REGISTER_RATE_LIMIT=3
APP_CONFIG__AUTH__REGISTER_RATE_WINDOW_SECONDS=300

# --- Telegram notifications (optional) ---
APP_CONFIG__TELEGRAM__BOT_TOKEN=change-me
APP_CONFIG__TELEGRAM__CHAT_ID=change-me

# --- Run configuration ---
APP_CONFIG__RUN__PUBLIC_URL=change-me

# --- Logging configuration ---
APP_CONFIG__LOG__LEVEL=INFO
APP_CONFIG__LOG__JSON_FORMAT=False